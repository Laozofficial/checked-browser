{
  "name": "checkd-browser",
  "version": "1.1.0",
  "description": "Check’d production monitoring for the browser: errors, failed requests, Web Vitals, custom events and opt-in session replay.",
  "license": "MIT",
  "author": "TwelveAI (https://twelveai.app)",
  "homepage": "https://getchecked.twelveai.app/docs/monitoring",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Laozofficial/checked-browser.git"
  },
  "bugs": {
    "url": "https://github.com/Laozofficial/checked-browser/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./replay": {
      "types": "./dist/replay/index.d.ts",
      "import": "./dist/replay.mjs"
    },
    "./checked.min.js": "./dist/checked.min.js",
    "./checked-replay.min.js": "./dist/checked-replay.min.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "esbuild": "0.24.0",
    "jsdom": "25.0.1",
    "rrweb": "2.1.6",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
